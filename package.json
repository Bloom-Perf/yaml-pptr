{
  "name": "@bloom-perf/yaml-pptr",
  "version": "2.0.2",
  "description": "A library to generate puppeteer browser controls through a YAML api.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "c8": "12.0.0",
    "chai": "6.3.0",
    "esbuild": "0.28.2",
    "esbuild-node-externals": "2.0.0",
    "mocha": "12.0.3",
    "prettier": "3.9.10",
    "puppeteer": "25.17.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "js-yaml": "^5.0.0",
    "zod": "^4.0.0"
  },
  "scripts": {
    "build": "rm -rf dist && node esbuild.js && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "mocha",
    "test:coverage": "c8 mocha",
    "example:login": "tsx examples/login-demo/run.ts",
    "example:load": "tsx examples/load-test/run.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bloom-Perf/yaml-pptr.git"
  },
  "keywords": [
    "puppeteer",
    "yaml",
    "testing"
  ],
  "author": "Bloom-perf",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/Bloom-Perf/yaml-pptr/issues"
  },
  "homepage": "https://www.npmjs.com/package/@bloom-perf/yaml-pptr"
}
